# Shard-Link: Environment Template
# Copy this to .env and fill in your values.

# ─── Hub ────────────────────────────────────────────────────────
# The primary API Key for MCP server authentication
HUB_API_KEY=your_mcp_api_key_here

# The public URL where the Hub is accessible
PUBLIC_URL=https://your-hub.example.com

# ─── Intelligence ───────────────────────────────────────────────
# Options:
#   none:   Mock vectors (Zero cost, Zero hardware load)
#   server: Gemini Cloud API (High quality, Zero hardware load, Free Tier)
#   local:  Tiny CPU-based model (Privacy-first, Low hardware load)
EMBEDDING_MODE=none
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=your_gemini_key_here
SUMMARIZER_MODEL=gemini-2.5-flash-lite
MMR_LAMBDA=0.7
COGNITIVE_BIAS_LAMBDA=0.7

# Local embedding (only if EMBEDDING_MODE=local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ─── Knowledge Mesh (Neo4j) ─────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password
MESH_LINK_THRESHOLD=0.75
JANITOR_RESONANCE_THRESHOLD=0.70

# ─── Archival Vessel (PostgreSQL) ───────────────────────────────
# Used by docker-compose.yml for container credentials
DB_USER=sharduser
DB_PASSWORD=your_postgres_password

# ─── Seed Memory (SQLite) ───────────────────────────────────────
# Path to the local SQLite database (Activity Ledger + Core Identity)
# Default: ./data/shard-link.db (local dev) or /app/data/shard-link.db (Docker)
DATABASE_PATH=./data/shard-link.db

# ─── Background Services ───────────────────────────────────────
SYNTHESIZER_INTERVAL_MINUTES=30

# ─── Storage Hygiene ────────────────────────────────────────────
ACTIVITY_LOG_RETENTION_DAYS=7
HYGIENE_INTERVAL_HOURS=24

# ─── Cloudflare Tunnel ──────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
