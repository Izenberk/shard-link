# Shard-Link: Environment Template

# --- Hub Configuration ---
# The primary API Key for MCP server authentication
HUB_API_KEY=your_mcp_api_key_here

# The public URL where the Hub is accessible (used for SSE discovery)
PUBLIC_URL=https://your-hub.example.com

# --- Intelligence Configuration (Phase 10) ---
# Options: 
#   none:   Mock vectors (Zero cost, Zero hardware load)
#   server: Gemini Cloud API (High quality, Zero hardware load, Free Tier)
#   local:  Tiny CPU-based model (Privacy-first, Low hardware load)
EMBEDDING_MODE=none
EMBEDDING_MODEL=text-embedding-004

# --- Knowledge Mesh (Neo4j) ---
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=shardpass

# --- High-Performance Storage (PostgreSQL) ---
DATABASE_URL=postgres://sharduser:shardpass@db:5432/shardlink?sslmode=disable

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=your_token_here
